---
import { clientProjects } from "../../scripts/landing_projects";
import ProjectFeatureCard from "../ProjectFeatureCard.astro";
---

<!-- ============ CLIENT PROJECTS ============ -->
<section id="clients" aria-label="Client Projects" class="bg-[#f7f6f4]">
  <div
    class="flex flex-col gap-3 px-6 pt-14 pb-9 sm:flex-row sm:items-baseline sm:justify-between sm:px-10 sm:gap-0"
  >
    <h2 class="text-[11px] font-normal tracking-[0.18em] text-[#888] uppercase">
      02 — Client Projects
    </h2>
    <div class="max-w-120 text-[13px] text-[#555] sm:text-right">
      Delivered under formal contracts — every client listed is available as a
      referee to confirm scope, delivery and professionalism.
    </div>
  </div>

  {clientProjects.map((project) => <ProjectFeatureCard project={project} />)}
</section>
