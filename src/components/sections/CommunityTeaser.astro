---
import ArrowRight from "../icons/ArrowRight.astro";
---

<!-- ============ COMMUNITY TEASER ============ -->
<section id="community" aria-label="Community" class="border-b border-[#0a0a0a]">
  <div class="flex items-baseline justify-between px-6 pt-14 pb-3 sm:px-10">
    <h2 class="text-[11px] font-normal tracking-[0.18em] text-[#888] uppercase">
      04 — Community
    </h2>
    <a
      href="/community"
      class="link-anim group inline-flex items-center gap-1.5 border-b border-[#0a0a0a] pb-0.5 text-[11px] tracking-[0.16em] uppercase"
    >
      Full timeline
      <ArrowRight class="icon-shift-x h-3.5 w-3.5" />
    </a>
  </div>
  <div class="max-w-205 px-6 pt-3 pb-14 sm:px-10" data-reveal>
    <div class="grid grid-cols-[72px_1fr] text-[13px] leading-[1.6] text-[#444] sm:grid-cols-[96px_1fr]">
      <div class="border-t border-[#ddd] py-4 font-semibold">2026</div>
      <div class="border-t border-[#ddd] py-4">
        Community contributions rendered as a chronological timeline — content from
        xephas.me/community lands here.
      </div>
      <div class="border-t border-[#ddd] py-4 font-semibold">2024</div>
      <div class="border-t border-[#ddd] py-4">Talks, mentorship &amp; open-source work.</div>
      <div class="border-t border-b border-[#ddd] py-4 font-semibold">2019</div>
      <div class="border-t border-b border-[#ddd] py-4">Where it all started.</div>
    </div>
  </div>
</section>
