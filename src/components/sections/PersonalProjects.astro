---

<!-- ============ PERSONAL PROJECTS ============ -->
<div id="personal">
  <div
    class="flex flex-col gap-3 px-6 pt-14 pb-9 sm:flex-row sm:items-baseline sm:justify-between sm:px-10 sm:gap-0"
  >
    <div class="text-[11px] tracking-[0.18em] text-[#888] uppercase">
      01 — Personal Projects
    </div>
    <div class="max-w-120 text-[13px] text-[#555] sm:text-right">
      Live platforms I design, build and maintain myself — proof of long-term
      reliability beyond initial delivery.
    </div>
  </div>

  <!-- Calcut: text left, image right -->
  <div class="group grid grid-cols-1 items-center gap-6 px-6 py-8 sm:px-10 lg:grid-cols-2 lg:gap-12" data-reveal>
    <div class="flex flex-col justify-between gap-8 py-4">
      <div>
        <div class="flex items-baseline justify-between">
          <div
            class="font-xeroda text-3xl font-semibold tracking-[-0.015em] sm:text-[38px]"
          >
            Calcut
          </div>
          <div class="ml-6 text-[11px] whitespace-nowrap tracking-[0.16em] text-[#888]">
            P–01 · SINCE 2019
          </div>
        </div>
        <div class="mt-4 max-w-130 text-sm leading-[1.65] text-[#444]">
          A free, fully-fledged cross-platform app trusted by students in Uganda to
          calculate their cut-off points in split seconds and discover the
          university courses they qualify for — based on their A'level subjects.
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-6">
        <div class="text-[11px] tracking-[0.16em] text-[#888] uppercase">
          7,000+ students · Android, iOS &amp; Web
        </div>
        <a
          href="https://calcut.app"
          target="_blank"
          rel="noopener noreferrer"
          class="border-b border-[#0a0a0a] pb-0.5 text-[11px] whitespace-nowrap tracking-[0.16em] uppercase"
        >
          calcut.app ↗
        </a>
      </div>
    </div>
    <!-- IMAGE SLOT: Calcut screenshots -->
    <div class="flex h-115 items-center justify-center overflow-hidden rounded-2xl bg-[#f7f6f4]">
      <div
        class="text-[11px] tracking-[0.16em] text-[#bbb] uppercase transition-transform duration-300 group-hover:scale-105"
      >
        Calcut screenshots
      </div>
    </div>
  </div>

  <!-- Linkyoo: image left, text right -->
  <div class="group grid grid-cols-1 items-center gap-6 px-6 py-8 sm:px-10 lg:grid-cols-2 lg:gap-12" data-reveal>
    <!-- IMAGE SLOT: Linkyoo screenshots -->
    <div
      class="order-2 flex h-115 items-center justify-center overflow-hidden rounded-2xl bg-[#f7f6f4] lg:order-1"
    >
      <div
        class="text-[11px] tracking-[0.16em] text-[#bbb] uppercase transition-transform duration-300 group-hover:scale-105"
      >
        Linkyoo screenshots
      </div>
    </div>
    <div class="order-1 flex flex-col justify-between gap-8 py-4 lg:order-2">
      <div>
        <div class="flex items-baseline justify-between">
          <div
            class="font-xeroda text-3xl font-semibold tracking-[-0.015em] sm:text-[38px]"
          >
            Linkyoo
          </div>
          <div class="ml-6 text-[11px] whitespace-nowrap tracking-[0.16em] text-[#888]">
            P–02 · SINCE 2024
          </div>
        </div>
        <div class="mt-4 max-w-130 text-sm leading-[1.65] text-[#444]">
          A digital business profile and menu platform — businesses present products
          and services through a single shareable link, with real-time updates and
          simple digital visibility without needing a complex website.
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-6">
        <div class="text-[11px] tracking-[0.16em] text-[#888] uppercase">
          Rolling out to businesses · Android, iOS &amp; Web
        </div>
        <a
          href="https://linkyoo.me"
          target="_blank"
          rel="noopener noreferrer"
          class="border-b border-[#0a0a0a] pb-0.5 text-[11px] whitespace-nowrap tracking-[0.16em] uppercase"
        >
          linkyoo.me ↗
        </a>
      </div>
    </div>
  </div>
</div>
