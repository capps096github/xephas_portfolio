---
import {
  baseUrl,
  coverImageAlt,
  coverImageHeight,
  coverImageWidth,
  developer,
  keywords,
  personSchema,
  siteManifest,
  websiteSchema,
} from "../scripts/constants.js";

import { ClientRouter } from "astro:transitions";

interface Props {
  pageTitle: string;
  pageDescription: string;
  pageCoverImage?: string;
  /** Path relative to baseUrl for this page's canonical URL, e.g. "" for home, "community/" for /community */
  canonicalPath?: string;
}

// Access passed-in component props, like `<X title="Hello, World" />`
// These are passed in with default parameters
const { pageTitle, pageCoverImage, pageDescription, canonicalPath = "" } = Astro.props;

const canonicalUrl = baseUrl + canonicalPath;

// mark as a component
// component: true;
---

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Astro Generator -->
  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta Tags -->
  <meta name="title" content={pageTitle} />
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content={developer.author} />
  <meta name="copyright" content={developer.copyright} />
  <meta name="robots" content="index, follow" />
  <meta name="rating" content="general" />
  <meta name="theme-color" content="#0a0a0a" />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Facebook Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:site_name" content={pageTitle} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={pageCoverImage} />
  <meta property="og:image:width" content={coverImageWidth} />
  <meta property="og:image:height" content={coverImageHeight} />
  <meta property="og:image:alt" content={coverImageAlt} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Open Graph -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:site" content={developer.handle} />
  <meta name="twitter:creator" content={developer.handle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={pageCoverImage} />
  <meta name="twitter:image:alt" content={coverImageAlt} />

  <!-- iOS meta tags & icons -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  <meta name="apple-mobile-web-app-title" content={pageTitle} />
  <link rel="apple-touch-icon"  type="image/svg+xml" href="/icons/apple-touch-icon.png" />

  <!--TODO: Add Favicon -->
  <!-- <link rel="icon" href="/icons/favicon.ico" sizes="any" /> -->
  <link rel="shortcut icon" type="image/svg+xml" href="/icons/favicon_star.svg" />


  <title>{pageTitle}</title>

  <!-- PWA SUPPORT -->
  <!-- <link rel="manifest" href={siteManifest} /> -->

  <!-- fonts -->
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,700&display=swap");
  </style>

  <!-- Structured data (JSON-LD) for search engines and AI answer/generative engines -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <!-- Astro page animations -->
  <ClientRouter />
</head>
