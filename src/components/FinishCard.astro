---
// The final step on /code/prepare and /code/export: submit the check report in
// the Tally form, then what happens next. Blue card (#1a56db, the /code link
// colour) so the end of the flow can't be missed. White on #1a56db is 6.2:1.
interface Props {
  /** Anchor id; in-text "the form" links point here. */
  id?: string;
  eyebrow: string;
  heading: string;
  lead: string;
  send: string[];
  next: { title: string; body: string }[];
  formUrl: string;
}
const { id = "finish", eyebrow, heading, lead, send, next, formUrl } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section id={id} class="scroll-mt-16 border-t border-[#0a0a0a] px-6 pt-14 pb-14 sm:px-10">
  <div class="max-w-5xl rounded-2xl bg-[#1a56db] p-6 text-white sm:p-10">
    <div class="text-[11px] font-semibold tracking-[0.18em] uppercase">{eyebrow}</div>
    <h2 class="font-xeroda mt-3 text-2xl font-semibold tracking-[-0.015em] sm:text-3xl">{heading}</h2>
    <p class="mt-4 max-w-2xl text-[15px] leading-[1.7]">{lead}</p>

    <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-10">
      <div class="min-w-0">
        <h3 class="text-[15px] font-semibold">What to put in the form</h3>
        <ul class="mt-3 space-y-2 text-[14px] leading-[1.65]">
          {
            send.map((item) => (
              <li class="flex gap-2">
                <span aria-hidden="true">—</span>
                <span class="min-w-0 break-words">{item}</span>
              </li>
            ))
          }
        </ul>
        <a
          href={formUrl}
          target="_blank"
          rel="noopener"
          class="btn-anim mt-6 inline-flex min-h-11 items-center gap-2 rounded-full bg-white px-7 py-4 text-xs font-semibold tracking-[0.14em] text-[#1a56db] uppercase focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a56db] focus-visible:outline-none"
        >
          Open the submission form
          <span class="sr-only">(opens in a new tab)</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-3.5"><path d="M7 17 17 7M7 7h10v10"></path></svg>
        </a>
      </div>
      <div class="min-w-0">
        <h3 class="text-[15px] font-semibold">What happens next</h3>
        <ol class="mt-3">
          {
            next.map((s, i) => (
              <li class="flex gap-4 border-t border-white/30 py-3">
                <span class="w-6 shrink-0 text-[11px] tracking-[0.18em] uppercase">{pad(i + 1)}</span>
                <span class="min-w-0">
                  <span class="block text-[14px] font-semibold">{s.title}</span>
                  <span class="mt-1 block text-[14px] leading-[1.6] break-words">{s.body}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
