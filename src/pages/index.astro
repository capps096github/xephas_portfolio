---
import "../styles/global.css";
import Head from "../components/Head.astro";
import FloatingNav from "../components/FloatingNav.astro";
import HeroWordmark from "../components/sections/HeroWordmark.astro";
import StatementPortrait from "../components/sections/StatementPortrait.astro";
import Marquee from "../components/sections/Marquee.astro";
import PersonalProjects from "../components/sections/PersonalProjects.astro";
import ClientProjects from "../components/sections/ClientProjects.astro";
import SchoolProjectsCta from "../components/sections/SchoolProjectsCta.astro";
import TechStack from "../components/sections/TechStack.astro";
import CommunityTeaser from "../components/sections/CommunityTeaser.astro";
import Footer from "../components/Footer.astro";
import { coverImage, description, title } from "../scripts/constants";
---

<!doctype html>
<html lang="en">
  <Head pageTitle={title} pageCoverImage={coverImage} pageDescription={description} />
  <body class="bg-white text-[#0a0a0a] antialiased">
    <FloatingNav />

    <main>
      <HeroWordmark />
      <StatementPortrait />
      <Marquee />
      <PersonalProjects />
      <ClientProjects />
      <SchoolProjectsCta />
      <TechStack />
      <CommunityTeaser />
    </main>
    <Footer />

    <!-- Firebase Scripts -->
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
      import { getAnalytics } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-analytics.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBqLGG656obraE1lKkTIOrJH6EQzLrDZyM",
        authDomain: "xephasme.firebaseapp.com",
        projectId: "xephasme",
        storageBucket: "xephasme.appspot.com",
        messagingSenderId: "319248268150",
        appId: "1:319248268150:web:6dccd45af1f8d396eed857",
        measurementId: "G-R5G40ZN9CM",
      };

      const app = initializeApp(firebaseConfig);
      const analytics = getAnalytics(app);
    </script>

    <!-- Hover spotlight pattern -->
    <script>
      import "../scripts/spotlight";
    </script>

    <!-- Scroll reveal -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const els = document.querySelectorAll("[data-reveal]");
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                target.style.opacity = "1";
                target.style.transform = "translateY(0)";
                io.unobserve(target);
              }
            });
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => {
          const target = el as HTMLElement;
          target.style.opacity = "0";
          target.style.transform = "translateY(28px)";
          target.style.transition =
            "opacity .8s cubic-bezier(.22,.61,.36,1), transform .8s cubic-bezier(.22,.61,.36,1)";
          io.observe(target);
        });
      });
    </script>
  </body>
</html>
