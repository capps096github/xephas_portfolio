---
import "../styles/global.css";
import Head from "../components/Head.astro";
import FloatingNav from "../components/FloatingNav.astro";
import Footer from "../components/Footer.astro";
import ArrowUpRight from "../components/icons/ArrowUpRight.astro";
import { codeName } from "../scripts/constants";
import { contactInfo } from "../scripts/social";

const title = `Page Not Found | ${codeName}`;
const pageDescription =
  "That page wandered off. Head back home, explore my projects, or book a call.";

// Call-to-actions, looped for consistency. The first is the primary action.
interface Cta {
  label: string;
  href: string;
  primary?: boolean;
  external?: boolean;
}
const ctas: Cta[] = [
  { label: "Go to home", href: "/", primary: true },
  { label: "Explore my projects", href: "/#personal" },
  { label: "Book a call", href: contactInfo.whatsapp, external: true },
  { label: "Community", href: "/community" },
  { label: "School projects", href: "/sch-projects" },
];
---

<!doctype html>
<html lang="en">
  <Head pageTitle={title} pageDescription={pageDescription} />
  <body class="bg-white text-[#0a0a0a] antialiased">
    <FloatingNav />

    <main
      class="flex min-h-screen flex-col items-center justify-center px-6 py-32 text-center sm:px-10"
    >
      <div data-reveal>
        <!-- Small kicker with the missing path -->
        <div class="text-[11px] tracking-[0.18em] text-[#888] uppercase">
          404 · Page
          <span class="text-[#0a0a0a]">"{Astro.url.pathname}"</span>
          not found
        </div>

        <!-- Headline (Linkyoo-style) -->
        <h1
          class="font-xeroda mx-auto mt-6 max-w-3xl text-[38px] leading-[1.06] font-semibold tracking-[-0.02em] text-balance sm:text-5xl lg:text-[64px] lg:leading-[1.02]"
        >
          Not all who wander are lost,<br />
          <span class="text-[#888]">but you maybe.</span>
        </h1>

        <p class="mx-auto mt-6 max-w-xl text-[15px] leading-[1.7] text-[#555]">
          The page you're looking for doesn't exist, moved, or never did. No
          worries — here are a few good places to land instead.
        </p>

        <!-- CTAs (looped) -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          {
            ctas.map((cta) =>
              cta.primary ? (
                <a
                  href={cta.href}
                  class="btn-anim rounded-full bg-[#0a0a0a] px-8 py-4 text-[12px] font-semibold tracking-[0.16em] text-white uppercase"
                >
                  {cta.label}
                </a>
              ) : (
                <a
                  href={cta.href}
                  target={cta.external ? "_blank" : undefined}
                  rel={cta.external ? "noopener noreferrer" : undefined}
                  class="btn-anim group inline-flex items-center gap-1.5 rounded-full border border-black/15 px-8 py-4 text-[12px] font-semibold tracking-[0.16em] text-[#0a0a0a] uppercase hover:border-black/40"
                >
                  {cta.label}
                  <ArrowUpRight class="icon-shift h-3.5 w-3.5" />
                </a>
              ),
            )
          }
        </div>
      </div>
    </main>

    <Footer />

    <!-- Firebase Scripts -->
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
      import { getAnalytics } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-analytics.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBqLGG656obraE1lKkTIOrJH6EQzLrDZyM",
        authDomain: "xephasme.firebaseapp.com",
        projectId: "xephasme",
        storageBucket: "xephasme.appspot.com",
        messagingSenderId: "319248268150",
        appId: "1:319248268150:web:6dccd45af1f8d396eed857",
        measurementId: "G-R5G40ZN9CM",
      };

      const app = initializeApp(firebaseConfig);
      const analytics = getAnalytics(app);
    </script>

    <!-- Scroll reveal -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const els = document.querySelectorAll("[data-reveal]");
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                target.style.opacity = "1";
                target.style.transform = "translateY(0)";
                io.unobserve(target);
              }
            });
          },
          { threshold: 0.08 },
        );
        els.forEach((el) => {
          const target = el as HTMLElement;
          target.style.opacity = "0";
          target.style.transform = "translateY(28px)";
          target.style.transition =
            "opacity .8s cubic-bezier(.22,.61,.36,1), transform .8s cubic-bezier(.22,.61,.36,1)";
          io.observe(target);
        });
      });
    </script>
  </body>
</html>
