---
import "../../styles/global.css";
import Head from "../../components/Head.astro";
import FloatingNav from "../../components/FloatingNav.astro";
import Footer from "../../components/Footer.astro";
import ArrowUpRight from "../../components/icons/ArrowUpRight.astro";
import Download from "../../components/icons/Download.astro";
import CopyHandle from "../../components/CopyHandle.astro";
import RichText from "../../components/RichText.astro";
import SubmitCta from "../../components/SubmitCta.astro";
import CopyPageMenu from "../../components/CopyPageMenu.astro";
import FinishCard from "../../components/FinishCard.astro";
import { baseUrl, githubHandle } from "../../scripts/constants.js";

import {
  prompts, downloads, handover, TOKEN_RE, tokenFor, steps,
  checkSteps, stepChecks, pad, checklist, remove, keep, runInstruction, faqs, exportSummary, finishSend, finishNext, CHECK_FORM_URL,
} from "../../scripts/code_prepare";
import { company } from "../../scripts/code_offer";

const ogImage = baseUrl + "images/code-prepare-og.png?v=1";
const ogImageAlt = "Preparing your repository for sale. Apta Innovations Limited, xephas.me/code/prepare.";
const pageTitle = "Preparing Your Repo | " + company + " through Cephas";
const pageDescription =
  "How shortlisted sellers clean a repository and its git history before sale: free scripts, a run_instruction.md template, and how the handover call and payment work.";

---

<!doctype html>
<html lang="en">
  <Head
    pageTitle={pageTitle}
    pageDescription={pageDescription}
    canonicalPath="code/prepare/"
    pageCoverImage={ogImage}
    pageCoverImageAlt={ogImageAlt}
    pageCoverImageWidth="1200"
    pageCoverImageHeight="630"
  />
  <body class="bg-white text-[#0a0a0a] antialiased">
    <FloatingNav />

    <!-- HERO -->
    <section class="spotlight z-10 border-b border-[#0a0a0a] px-6 pt-28 pb-14 sm:px-10 sm:pt-32">
      <div class="text-[11px] tracking-[0.18em] text-[#888] uppercase">
        <a href="/code/" class="link-underline inline-block">{company} · Source Code Acquisition</a>
      </div>
      <h1
        class="font-xeroda mt-6 max-w-4xl text-[34px] leading-[1.08] font-semibold tracking-[-0.02em] text-balance sm:text-5xl lg:text-[56px]"
        data-reveal
      >
        Preparing your repo for sale.
      </h1>
      <p class="mt-6 max-w-2xl text-[15px] leading-[1.7] text-[#555]">
        Once your project is shortlisted, you clean the repository and its git
        history before we pay, using the free scripts on this page. Then you
        export the archive yourself, and payment is released on a call once
        we've verified it.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#steps"
          class="btn-anim inline-flex items-center gap-2 rounded-full bg-[#0a0a0a] px-7 py-4 text-xs font-semibold tracking-[0.14em] text-[#f4f2ef] uppercase"
        >
          Start the clean-up
        </a>
        <a href="#checklist" class="inline-block text-[13px] font-semibold text-[#1a56db] hover:text-[#0b3a9e] transition-colors">See the checklist</a>
        <a href="#downloads" class="inline-block text-[13px] font-semibold text-[#1a56db] hover:text-[#0b3a9e] transition-colors">Download the scripts</a>
        <a href="#export" class="inline-block text-[13px] font-semibold text-[#1a56db] hover:text-[#0b3a9e] transition-colors">Export the archive</a>
        <a href="#finish" class="inline-block text-[13px] font-semibold text-[#1a56db] hover:text-[#0b3a9e] transition-colors">Submit your code</a>
        <CopyPageMenu md="/code/prepare.md" />
      </div>
    </section>

    <!-- HANDOVER -->
    <section class="px-6 pt-14 pb-14 sm:px-10">
      <h2 class="font-xeroda text-2xl font-semibold tracking-[-0.015em] sm:text-3xl">How the handover works</h2>
      <ol class="mt-8 grid grid-cols-1 gap-x-10 sm:grid-cols-2 lg:grid-cols-5" data-reveal>
        {
          handover.map((s) => (
            <li class="border-t border-[#e5e3df] py-5">
              <div class="text-[11px] tracking-[0.18em] text-[#999] uppercase">{s.n}</div>
              <div class="mt-2 text-[15px] font-semibold">{s.title}</div>
              <p class="mt-2 text-[14px] leading-[1.65] text-[#555]"><RichText text={s.body} /></p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- STEPS -->
    <section id="steps" class="bg-[#f7f6f4] px-6 pt-14 pb-14 sm:px-10">
      <h2 class="font-xeroda text-2xl font-semibold tracking-[-0.015em] sm:text-3xl">Step by step</h2>
      <p class="mt-4 max-w-2xl text-[15px] leading-[1.7] text-[#555]">
        These steps take your repo from where it is today to a cleaned
        repository, every branch and tag, ready for export. Enter your GitHub
        username and repository name and every command below fills them in.
        Make the backup in step 01 before anything else.
      </p>
      <p class="mt-3 max-w-2xl text-[15px] leading-[1.7] text-[#555]">
        Use this section to generate the exact commands and scripts for your
        repo, then copy them from here. Don't run things by hand from memory
        or from another guide: the steps and flags have to match, and doing
        it differently can mean redoing the work.
      </p>
      <div class="mt-6 grid max-w-3xl gap-4 sm:grid-cols-2">
        {
          [
            { key: "user", label: "GitHub username", placeholder: "github-username" },
            { key: "repo", label: "Repository name", placeholder: "repo-name" },
          ].map((field) => (
            <label class="block">
              <span class="text-[11px] tracking-[0.18em] text-[#888] uppercase">{field.label}</span>
              <input
                type="text"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder={field.placeholder}
                data-repo-field={field.key}
                class="mt-2 w-full min-w-0 rounded-xl border border-[#0a0a0a]/15 bg-white px-4 py-3 font-mono text-[14px] placeholder:text-[#0a0a0a]/30 focus-visible:ring-2 focus-visible:ring-[#0a0a0a] focus-visible:outline-none"
              />
            </label>
          ))
        }
      </div>
      <p class="mt-3 max-w-3xl text-[13px] leading-[1.6] text-[#666]">
        You can also paste the full repo URL into either field. On GitLab or
        Bitbucket, swap github.com for your host after copying.
      </p>
      <ol class="mt-8 max-w-3xl">
        {
          steps.map((s, i) => (
            <li id={`step-${i + 1}`} class="min-w-0 scroll-mt-24 border-t border-[#e5e3df] py-6">
              <div class="flex gap-4">
                <div class="w-8 shrink-0 text-[11px] tracking-[0.18em] text-[#999] uppercase">
                  {String(i + 1).padStart(2, "0")}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-[16px] font-semibold">{s.title}</div>
                  <p class="mt-2 text-[14px] leading-[1.65] text-[#555]"><RichText text={s.body} /></p>
                  {s.note && (
                    <p class="mt-3 rounded-xl border border-[#0a0a0a] bg-white px-4 py-3 text-[14px] leading-[1.65] font-semibold"><RichText text={s.note} /></p>
                  )}
                  {s.link && (
                    <a
                      href={s.link.href}
                      download={!s.link.href.startsWith("#")}
                      class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-[#0a0a0a]/15 bg-white px-3 py-1.5 text-xs font-semibold transition-colors hover:bg-[#0a0a0a] hover:text-[#f4f2ef]"
                    >
                      <Download class="h-3.5 w-3.5" />
                      {s.link.label}
                    </a>
                  )}
                  {s.code && (
                    <div class="relative mt-4">
                      <pre class="overflow-x-auto rounded-xl bg-[#0a0a0a] p-4 pr-16 font-mono text-[12.5px] leading-[1.6] text-[#f4f2ef]"><code>{s.code.split(TOKEN_RE).map((part) => part in tokenFor ? <span class="repo-token" data-token={tokenFor[part as keyof typeof tokenFor].key} data-empty>{tokenFor[part as keyof typeof tokenFor].placeholder}</span> : part)}</code></pre>
                      <button
                        type="button"
                        data-copy
                        class="absolute top-2.5 right-2.5 rounded-full border border-[#f4f2ef]/25 px-2.5 py-1 text-[11px] font-semibold text-[#f4f2ef] transition-colors hover:bg-[#f4f2ef] hover:text-[#0a0a0a]"
                      >
                        Copy
                      </button>
                    </div>
                  )}
                  {stepChecks[i].length > 0 && (
                    <p class="mt-4 text-[13px] leading-[1.6] text-[#666]">
                      Checklist:{" "}
                      {stepChecks[i].map((c, k) => (
                        <>
                          {k > 0 && " · "}
                          <a href={`#check-${c}`} class="font-semibold text-[#1a56db] transition-colors hover:text-[#0b3a9e]">{pad(c)}</a>
                        </>
                      ))}
                    </p>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- CHECKLIST -->
    <section id="checklist" class="border-t border-[#0a0a0a] px-6 pt-14 pb-14 sm:px-10">
      <div class="flex max-w-3xl flex-wrap items-end justify-between gap-4">
        <h2 class="font-xeroda text-2xl font-semibold tracking-[-0.015em] sm:text-3xl">Before we pay: the checklist</h2>
        <div class="text-[13px] font-semibold" aria-live="polite"><span data-check-count>0</span> of {checklist.length} done</div>
      </div>
      <p class="mt-4 max-w-2xl text-[15px] leading-[1.7] text-[#555]">
        Work through every item on your repository: the current files{" "}
        <em>and</em> the git history. Anything ever committed ships with the
        sale, and deleting a file today doesn't remove it from older commits.
        check-repo.sh finds every problem below, and clean-history.sh fixes
        them on a copy. Your ticks are saved in this browser.
      </p>
      <div class="mt-4 h-1 max-w-3xl overflow-hidden rounded-full bg-[#e5e3df]">
        <div data-check-bar class="h-full w-0 bg-[#0a0a0a] transition-[width] duration-300"></div>
      </div>
      <ol class="mt-6 max-w-3xl">
        {
          checklist.map((c, i) => (
            <li id={`check-${i + 1}`} class="min-w-0 scroll-mt-24 border-t border-[#e5e3df] py-5">
              <label class="flex cursor-pointer gap-4">
                <input type="checkbox" data-check={i} class="mt-0.5 h-5 w-5 shrink-0 cursor-pointer accent-[#0a0a0a]" />
                <span class="min-w-0">
                  <span class="text-[11px] tracking-[0.18em] text-[#999] uppercase">{String(i + 1).padStart(2, "0")}</span>
                  <span class="check-title mt-1 block text-[16px] font-semibold">{c.title}</span>
                </span>
              </label>
              <div class="mt-2 pl-9">
                {c.items && (
                  <ul class="mb-2 space-y-1 text-[14px] leading-[1.6]">
                    {c.items.map((it) => (
                      <li class="flex gap-2">
                        <span class="text-[#999]">—</span>
                        <span class="min-w-0 break-words">{it}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <p class="text-[14px] leading-[1.65] text-[#555]"><RichText text={c.body} /></p>
                <p class="mt-3 text-[13px] leading-[1.6] text-[#666]">
                  Done in step{checkSteps[i].length > 1 ? "s" : ""}:{" "}
                  {checkSteps[i].map((st, k) => (
                    <>
                      {k > 0 && " · "}
                      <a href={`#step-${st}`} class="font-semibold text-[#1a56db] transition-colors hover:text-[#0b3a9e]">{pad(st)}</a>
                    </>
                  ))}
                </p>
                {c.link && (
                  <a href={c.link.href} class="mt-2 inline-block text-[13px] font-semibold text-[#1a56db] hover:text-[#0b3a9e] transition-colors">{c.link.label}</a>
                )}
                {c.code && (
                  <div class="mt-3">
                    {c.codeNote && <p class="mb-2 text-[13px] font-semibold">{c.codeNote}</p>}
                    <div class="relative">
                      <pre class="overflow-x-auto rounded-xl bg-[#0a0a0a] p-4 pr-16 font-mono text-[12.5px] leading-[1.6] text-[#f4f2ef]"><code>{c.code.split(TOKEN_RE).map((part) => part in tokenFor ? <span class="repo-token" data-token={tokenFor[part as keyof typeof tokenFor].key} data-empty>{tokenFor[part as keyof typeof tokenFor].placeholder}</span> : part)}</code></pre>
                      <button
                        type="button"
                        data-copy
                        class="absolute top-2.5 right-2.5 rounded-full border border-[#f4f2ef]/25 bg-[#0a0a0a] px-2.5 py-1 text-[11px] font-semibold text-[#f4f2ef] transition-colors hover:bg-[#f4f2ef] hover:text-[#0a0a0a]"
                      >
                        Copy
                      </button>
                    </div>
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 max-w-3xl border-t border-[#0a0a0a] pt-5 text-[14px] leading-[1.65]">
        <span class="font-semibold">When every box is ticked:</span> you submit
        <a href="#finish" class="font-semibold text-[#1a56db] hover:text-[#0b3a9e] transition-colors">the form</a>: your name, the report and your archive. We
        then verify the archive you exported on a call, and payment is released
        once it passes the checks.
      </p>
    </section>


    <!-- EXPORT: the crucial step. Short version; full guide on /code/export -->
    <section id="export" class="scroll-mt-16 border-t border-[#0a0a0a] px-6 pt-14 pb-14 sm:px-10">
      <div class="max-w-3xl rounded-2xl border-2 border-[#0a0a0a] bg-white p-5 sm:p-8">
        <div class="text-[11px] font-semibold tracking-[0.18em] text-[#0a0a0a] uppercase">The crucial step</div>
        <h2 class="font-xeroda mt-3 text-2xl font-semibold tracking-[-0.015em] sm:text-3xl">Export the archive</h2>
        <p class="mt-4 text-[15px] leading-[1.7] text-[#555]">{exportSummary.lead}</p>
        <div class="mt-6 grid grid-cols-1 gap-4">
          {
            [exportSummary.routeA].map((r) => (
              <div class="min-w-0 rounded-xl border border-[#0a0a0a] p-4">
                <h3 class="text-[15px] font-semibold">{r.title}</h3>
                <p class="mt-2 text-[13px] leading-[1.6] font-semibold">{r.who}</p>
                <p class="mt-2 text-[14px] leading-[1.65] text-[#555]">{r.body}</p>
              </div>
            ))
          }
        </div>
        <h3 class="mt-8 text-[15px] font-semibold">In brief (GitHub)</h3>
        <ol class="mt-3 grid grid-cols-1 gap-x-8 sm:grid-cols-2">
          {
            exportSummary.points.map((p, i) => (
              <li class="min-w-0 border-t border-[#e5e3df] py-4">
                <div class="text-[11px] tracking-[0.18em] text-[#999] uppercase">{pad(i + 1)}</div>
                <div class="mt-1 text-[15px] font-semibold">{p.title}</div>
                <p class="mt-1 text-[14px] leading-[1.65] break-words text-[#555]">{p.body}</p>
              </li>
            ))
          }
        </ol>
        <p class="mt-4 rounded-xl border border-[#0a0a0a] px-4 py-3 text-[14px] leading-[1.65] font-semibold">{exportSummary.warning}</p>
        <p class="mt-3 text-[14px] leading-[1.65] text-[#555]">
          {exportSummary.pullNote.split(/(step \d\d)/).map((part) =>
            /^step \d\d$/.test(part) ? <a href={`#step-${Number(part.slice(5))}`} class="font-semibold text-[#1a56db] transition-colors hover:text-[#0b3a9e]">{part}</a> : part,
          )}
        </p>
        <div class="relative mt-5">
          <pre class="overflow-x-auto rounded-xl bg-[#0a0a0a] p-4 pr-16 font-mono text-[12.5px] leading-[1.6] text-[#f4f2ef]"><code>{exportSummary.code.split(TOKEN_RE).map((part) => part in tokenFor ? <span class="repo-token" data-token={tokenFor[part as keyof typeof tokenFor].key} data-empty>{tokenFor[part as keyof typeof tokenFor].placeholder}</span> : part)}</code></pre>
          <button
            type="button"
            data-copy
            class="absolute top-2.5 right-2.5 rounded-full border border-[#f4f2ef]/25 bg-[#0a0a0a] px-2.5 py-1 text-[11px] font-semibold text-[#f4f2ef] transition-colors hover:bg-[#f4f2ef] hover:text-[#0a0a0a]"
          >
            Copy
          </button>
        </div>
        <div class="mt-6 text-[11px] tracking-[0.18em] text-[#888] uppercase">The archive must contain</div>
        <ul class="mt-2 space-y-1 text-[14px] leading-[1.6]">
          {
            exportSummary.inside.map((it) => (
              <li class="flex gap-2">
                <span class="text-[#999]">—</span>
                <span class="min-w-0 break-words">{it}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-[14px] leading-[1.65] text-[#555]">
          {exportSummary.runNote.split(/(step \d\d)/).map((part) =>
            /^step \d\d$/.test(part) ? <a href={`#step-${Number(part.slice(5))}`} class="font-semibold text-[#1a56db] transition-colors hover:text-[#0b3a9e]">{part}</a> : part,
          )}{" "}
          <a href="#run-instruction" class="font-semibold text-[#1a56db] transition-colors hover:text-[#0b3a9e]">What it must cover</a>.
        </p>
        <a
          href="/code/export/"
          class="btn-anim mt-6 inline-flex items-center gap-2 rounded-full bg-[#0a0a0a] px-7 py-4 text-xs font-semibold tracking-[0.14em] text-[#f4f2ef] uppercase"
        >
          The full guide, with screenshots
          <ArrowUpRight class="h-3.5 w-3.5" />
        </a>
        <p class="mt-3 text-[13px] leading-[1.6] text-[#666]">Includes GitLab, organisation repositories, and how to verify the archive.</p>
      </div>
    </section>

    <!-- REMOVE / KEEP -->
    <section class="bg-[#f7f6f4] px-6 pt-14 pb-14 sm:px-10">
      <h2 class="font-xeroda text-2xl font-semibold tracking-[-0.015em] sm:text-3xl">What goes, what stays</h2>
      <p class="mt-4 max-w-2xl text-[15px] leading-[1.7] text-[#555]">
        The sale includes the full git history, so anything that was
        <em>ever</em> committed ships with it, even if a later commit deleted
        it. Deleting a file or adding it to .gitignore doesn't remove it from
        history; only rewriting history does.
      </p>
      <div class="mt-8 grid max-w-5xl grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-2" data-reveal>
        <div class="min-w-0">
          <div class="text-[11px] tracking-[0.18em] text-[#888] uppercase">Remove from every commit</div>
          <ul class="mt-3">
            {
              remove.map((item) => (
                <li class="flex gap-3 border-t border-[#e5e3df] py-3 text-[14px] leading-[1.6] break-words">
                  <span class="text-[#999]">✕</span>
                  <span class="min-w-0">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="min-w-0">
          <div class="text-[11px] tracking-[0.18em] text-[#888] uppercase">Keep</div>
          <ul class="mt-3">
            {
              keep.map((item) => (
                <li class="flex gap-3 border-t border-[#e5e3df] py-3 text-[14px] leading-[1.6] break-words">
                  <span class="text-[#999]">✓</span>
                  <span class="min-w-0">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- DOWNLOADS -->
    <section id="downloads" class="border-t border-[#0a0a0a] px-6 pt-14 pb-14 sm:px-10">
      <h2 class="font-xeroda text-2xl font-semibold tracking-[-0.015em] sm:text-3xl">The scripts</h2>
      <p class="mt-4 max-w-2xl text-[15px] leading-[1.7] text-[#555]">
        Free, plain bash, and readable before you run them. None of them pushes
        to your repo: clean-history.sh prints the push command for you to run
        yourself. They run on macOS and Linux, and on Windows through Git Bash
        or WSL.
      </p>
      <div class="mt-8 grid grid-cols-1 gap-x-10 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
        {
          downloads.map((d) => (
            <div class="flex min-w-0 flex-col border-t border-[#e5e3df] py-5">
              <div class="font-mono text-[14px] font-semibold break-all">{d.title}</div>
              <p class="mt-2 flex-1 text-[14px] leading-[1.65] text-[#555]"><RichText text={d.body} /></p>
              <div class="mt-4 flex flex-wrap gap-3">
                <a
                  href={`/code/${d.file}`}
                  download={d.file}
                  class="inline-flex items-center gap-1.5 rounded-full border border-[#0a0a0a]/15 bg-white px-3 py-1.5 text-xs font-semibold transition-colors hover:bg-[#0a0a0a] hover:text-[#f4f2ef]"
                >
                  <Download class="h-3.5 w-3.5" />
                  Download
                </a>
                <a
                  href={`/code/${d.file}`}
                  target="_blank"
                  rel="noopener"
                  class="link-underline inline-flex items-center gap-1 text-xs font-semibold"
                >
                  View
                  <ArrowUpRight class="h-3 w-3" />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- RUN INSTRUCTIONS -->
    <section id="run-instruction" class="scroll-mt-16 border-t border-[#0a0a0a] px-6 pt-14 pb-14 sm:px-10">
      <h2 class="font-xeroda text-2xl font-semibold tracking-[-0.015em] sm:text-3xl">run_instruction.md</h2>
      <p class="mt-4 max-w-2xl text-[15px] leading-[1.7] text-[#555]">
        A required file at the root of the repo. Write it for a developer who
        has never seen your project and has none of your accounts, keys or
        machine setup. It must cover:
      </p>
      <div class="mt-8 grid grid-cols-1 gap-x-10 sm:grid-cols-2 lg:grid-cols-5" data-reveal>
        {
          runInstruction.map((r) => (
            <div class="border-t border-[#e5e3df] py-5">
              <div class="text-[15px] font-semibold">{r.title}</div>
              <p class="mt-2 text-[14px] leading-[1.65] text-[#555]">{r.body}</p>
            </div>
          ))
        }
      </div>
      <a
        href="/code/run_instruction.template.md"
        download
        class="mt-6 inline-flex items-center gap-1.5 rounded-full border border-[#0a0a0a]/15 bg-white px-3 py-1.5 text-xs font-semibold transition-colors hover:bg-[#0a0a0a] hover:text-[#f4f2ef]"
      >
        <Download class="h-3.5 w-3.5" />
        Download the template
      </a>
    </section>

    <!-- AI DOCS -->
    <section id="ai-docs" class="bg-[#f7f6f4] px-6 pt-14 pb-14 sm:px-10">
      <h2 class="font-xeroda text-2xl font-semibold tracking-[-0.015em] sm:text-3xl">Write the docs with AI</h2>
      <p class="mt-4 max-w-2xl text-[15px] leading-[1.7] text-[#555]">
        Open your repo in an AI coding assistant (Claude Code, Cursor, GitHub
        Copilot or similar) and paste each prompt. It reads your actual code
        and writes the file, using only versions, commands and features that
        exist in the repo. Docs written with AI are fine; the code itself must
        be yours.
      </p>
      <ul class="mt-4 max-w-2xl space-y-1 text-[14px] leading-[1.65] text-[#555]">
        <li>— Read every line before you commit it, and fix anything that's wrong.</li>
        <li>— Make sure the tool didn't add its own files (CLAUDE.md, AGENTS.md, .cursor/). clean-history.sh removes them anyway.</li>
        <li>— Commit both files on every branch and push them before you run clean-history.sh (step 05).</li>
      </ul>
      <div class="mt-8 grid max-w-5xl grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2">
        {
          prompts.map((p) => (
            <div class="min-w-0 border-t border-[#e5e3df] pt-5">
              <div class="font-mono text-[14px] font-semibold">{p.title}</div>
              <p class="mt-2 text-[14px] leading-[1.65] text-[#555]">{p.body}</p>
              <div class="mt-4">
                <div class="mb-3 flex flex-wrap items-center gap-3">
                  <button
                    type="button"
                    data-copy-prompt
                    data-label={`Copy the ${p.title} prompt`}
                    class="btn-anim inline-flex items-center gap-2 rounded-full bg-[#0a0a0a] px-6 py-3 text-xs font-semibold tracking-[0.12em] text-[#f4f2ef] uppercase"
                  >
                    Copy the {p.title} prompt
                  </button>
                  <a
                    href={`/code/${p.file}`}
                    download
                    class="inline-flex items-center gap-1.5 rounded-full border border-[#0a0a0a]/15 bg-white px-3 py-1.5 text-xs font-semibold transition-colors hover:bg-[#0a0a0a] hover:text-[#f4f2ef]"
                  >
                    <Download class="h-3.5 w-3.5" />
                    Download
                  </a>
                </div>
                <pre class="max-h-80 overflow-auto rounded-xl bg-[#0a0a0a] p-4 font-mono text-[12px] leading-[1.6] whitespace-pre-wrap text-[#f4f2ef]"><code>{p.text}</code></pre>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- FINAL STEP: submit the check report -->
    <FinishCard
      eyebrow="Final step"
      heading="Submit your code"
      lead="When every step and checklist item is done and you have exported the archive, submit the form. Invite the GitHub account with Read access first. It opens in a new tab."
      send={finishSend}
      next={finishNext}
      formUrl={CHECK_FORM_URL}
    />

    <!-- FAQ -->
    <section class="border-t border-[#0a0a0a] px-6 pt-14 pb-14 sm:px-10">
      <h2 class="font-xeroda text-2xl font-semibold tracking-[-0.015em] sm:text-3xl">Questions</h2>
      <div class="mt-8 grid max-w-5xl grid-cols-1 gap-x-10 md:grid-cols-2" data-reveal>
        {
          faqs.map((f) => (
            <div class="border-t border-[#e5e3df] py-5">
              <div class="text-[15px] font-semibold">{f.q}</div>
              <p class="mt-2 text-[14px] leading-[1.65] text-[#555]"><RichText text={f.a} /></p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <SubmitCta
      eyebrow="Ready, or stuck?"
      heading="Submit your repo, or send us your check-repo.sh report and we'll tell you what to fix."
      secondary={{ href: "/code/calc/", label: "Price your repo" }}
    />

    <Footer />

    <style>
      .repo-token {
        border-radius: 4px;
        background: rgba(244, 242, 239, 0.14);
        padding: 0 2px;
      }
      .repo-token[data-empty] {
        color: #f5c46b;
      }
      li:has(> label > input[data-check]:checked) .check-title {
        text-decoration: line-through;
        color: #888;
      }
    </style>

    <!-- Repo fields: fill the username / repo tokens in every command -->
    <script>
      const PLACEHOLDERS: Record<string, string> = { user: "{github-username}", repo: "{repo-name}" };
      const STORE = "code-prepare-repo";
      const fields = document.querySelectorAll<HTMLInputElement>("[data-repo-field]");
      const field = (key: string) => [...fields].find((f) => f.dataset.repoField === key)!;

      // Keep only what's valid in a GitHub owner / repo name; drop a trailing .git.
      const clean = (v: string) => v.trim().replace(/\.git$/, "").replace(/[^A-Za-z0-9._-]/g, "");

      // Owner/repo from a pasted URL ("https://github.com/o/r.git", "git@github.com:o/r") or "owner/repo".
      // Extra path (/tree/main) is only dropped for github.com; other hosts may use subgroups, so no autofill.
      function parseRepo(v: string): { user: string; repo: string } | null {
        const m = v.trim().match(/^(?:https?:\/\/([^/]+)\/|git@([^:]+):)?([A-Za-z0-9._-]+)\/([A-Za-z0-9._-]+?)(?:\.git)?(\/.*)?$/);
        if (!m) return null;
        const host = m[1] || m[2] || "";
        if (m[5] && !/(^|\.)github\.com$/i.test(host)) return null;
        return { user: m[3], repo: m[4] };
      }

      function apply() {
        const values: Record<string, string> = {};
        fields.forEach((f) => (values[f.dataset.repoField!] = clean(f.value)));
        document.querySelectorAll<HTMLElement>("[data-token]").forEach((t) => {
          const v = values[t.dataset.token!];
          t.textContent = v || PLACEHOLDERS[t.dataset.token!];
          t.toggleAttribute("data-empty", !v);
        });
        try {
          localStorage.setItem(STORE, JSON.stringify(values));
        } catch {}
      }

      fields.forEach((f) =>
        f.addEventListener("input", () => {
          // A pasted URL or owner/repo fills both fields.
          const parsed = parseRepo(f.value);
          if (parsed) {
            field("user").value = parsed.user;
            field("repo").value = parsed.repo;
          }
          apply();
        }),
      );

      try {
        const saved = JSON.parse(localStorage.getItem(STORE) ?? "{}");
        fields.forEach((f) => (f.value = saved[f.dataset.repoField!] ?? ""));
      } catch {}
      apply();
    </script>

    <!-- Checklist: progress count, saved per browser -->
    <script>
      const KEY = "code-prepare-checklist";
      const boxes = document.querySelectorAll<HTMLInputElement>("[data-check]");
      const count = document.querySelector<HTMLElement>("[data-check-count]");
      const bar = document.querySelector<HTMLElement>("[data-check-bar]");
      function update() {
        const done = [...boxes].filter((b) => b.checked).map((b) => b.dataset.check);
        if (count) count.textContent = String(done.length);
        if (bar) bar.style.width = `${(done.length / boxes.length) * 100}%`;
        try {
          localStorage.setItem(KEY, JSON.stringify(done));
        } catch {}
      }
      try {
        const saved: string[] = JSON.parse(localStorage.getItem(KEY) ?? "[]");
        boxes.forEach((b) => (b.checked = saved.includes(b.dataset.check!)));
      } catch {}
      boxes.forEach((b) => b.addEventListener("change", update));
      update();
    </script>

    <!-- Copy buttons -->
    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const code = btn.parentElement?.querySelector("code")?.textContent ?? "";
          try {
            await navigator.clipboard.writeText(code);
            btn.textContent = "Copied";
          } catch {
            btn.textContent = "Select & copy";
          }
          setTimeout(() => (btn.textContent = "Copy"), 1600);
        });
      });
      // Prompt buttons sit above their block; copy the whole prompt in one click.
      document.querySelectorAll<HTMLButtonElement>("[data-copy-prompt]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const code = btn.closest("div")?.parentElement?.querySelector("pre code")?.textContent ?? "";
          try {
            await navigator.clipboard.writeText(code);
            btn.textContent = "Copied. Paste it into your AI assistant";
          } catch {
            btn.textContent = "Select the text below and copy";
          }
          setTimeout(() => (btn.textContent = btn.dataset.label ?? "Copy prompt"), 2400);
        });
      });
    </script>

    <!-- Hover spotlight pattern -->
    <script>
      import "../../scripts/spotlight";
    </script>

    <!-- Scroll reveal -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const els = document.querySelectorAll("[data-reveal]");
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                target.style.opacity = "1";
                target.style.transform = "translateY(0)";
                io.unobserve(target);
              }
            });
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => {
          const target = el as HTMLElement;
          target.style.opacity = "0";
          target.style.transform = "translateY(28px)";
          target.style.transition =
            "opacity .8s cubic-bezier(.22,.61,.36,1), transform .8s cubic-bezier(.22,.61,.36,1)";
          io.observe(target);
        });
      });
    </script>
  </body>
</html>
